Question: Binary Tree Bottom View 
class Solution {
  public:
    vector<int> bottomView(Node *root) {
        // code here
        queue<pair<Node*,int>>q;
        map<int,int> map;// map<code>,node->data>
        q.push({root,0});
        while(!q.empty()){
            int n=q.size();
            while(n--){
                auto pair=q.front();
                q.pop();
                Node* curr=pair.first;
                int code = pair.second;
                map[code]=curr->data;
                if(curr->left)
                   q.push({curr->left,code-1});
                if(curr->right)
                    q.push({curr->right,code+1});
            }
        }
        vector<int>ans;
        for(auto i:map){
            ans.push_back(i.second);
        }
        return ans;
    }
};
Question : Top View of binary tree 
class Solution {
public:
    vector<int> topView(Node *root) {
        queue<pair<Node*,int>>q;
        map<int,int> map;// map<code>,node->data>
        q.push({root,0});
        while(!q.empty()){
            int n=q.size();
            while(n--){
                auto pair=q.front();
                q.pop();
                Node* curr=pair.first;
                int code = pair.second;
                map.insert({code,curr->data});
                if(curr->left)
                   q.push({curr->left,code-1});
                if(curr->right)
                    q.push({curr->right,code+1});
            }
        }
        vector<int>ans;
        for(auto i:map){
            ans.push_back(i.second);
        }
        return ans;
    }
};
Breath First Search . 
class Solution {
  public:
    vector<int> bfs(vector<vector<int>> &adj) {
        // code here
        int n=adj.size();
        queue<int>q;
        vector<int> ans;
        vector<bool> status(n,false);
        q.push(0);
        status[0]=true;
        while(!q.empty()){
            int curr=q.front();
            q.pop();
            ans.push_back(curr);
            for(int i=0;i<adj[curr].size();i++){
                if(status[adj[curr][i]]==false){
                    (status[adj[curr][i]]=true);
                    q.push(adj[curr][i]);
                    
                }
            }
            
        }
        return ans;
    }
};
